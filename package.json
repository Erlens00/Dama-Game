  "engines": {
    "node": ">=18.18.0 <21"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "framer-motion": "11.3.19",
    "canvas-confetti": "1.9.3",
    "socket.io": "4.7.5",
    "socket.io-client": "4.7.5",
    "typescript": "5.5.4",
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/canvas-confetti": "1.6.4",
    "tailwindcss": "3.4.7",
    "postcss": "8.4.40",
    "autoprefixer": "10.4.19",
    "tsx": "4.16.2",
    "cross-env": "7.0.3"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "vitest": "2.0.5"
